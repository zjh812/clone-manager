<resources>
    <attr name="rootBackground" format="reference" />
    <style name="Theme.CloneManager" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="colorPrimary">@color/hero_text</item>
        <item name="colorOnPrimary">#1B3A6B</item>
        <item name="colorPrimaryContainer">#3D6DB5</item>
        <item name="colorOnPrimaryContainer">#FFFFFF</item>
        <item name="android:textColor">@color/hero_text</item>
        <item name="android:textColorHint">#B8C9E8</item>
        <item name="android:colorBackground">#1B3A6B</item>
        <item name="colorSurface">#26497F</item>
        <item name="colorOnSurface">#FFFFFF</item>
        <item name="colorSurfaceVariant">#2E5A9E</item>
        <item name="colorOnSurfaceVariant">#D8E4F7</item>
        <item name="colorOutline">#66FFFFFF</item>
        <item name="colorError">#FF8A8A</item>
        <item name="colorOnError">#3A0A0A</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.CloneManager.Dialog</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.CloneManager.Dialog</item>
        <item name="materialButtonStyle">@style/Widget.CloneManager.Button</item>
        <item name="checkboxStyle">@style/Widget.CloneManager.Checkbox</item>
        <item name="tabStyle">@style/Widget.CloneManager.Tab</item>
        <item name="rootBackground">@drawable/bg_app_root</item>
    </style>
    <style name="Widget.CloneManager.Button" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">#FFFFFF</item>
        <item name="strokeColor">#66FFFFFF</item>
        <item name="backgroundTint">@android:color/transparent</item>
    </style>
    <style name="Widget.CloneManager.Checkbox" parent="Widget.Material3.CompoundButton.CheckBox">
        <item name="android:button">@drawable/ic_checkbox_selector</item>
    </style>
    <style name="Widget.CloneManager.Tab" parent="Widget.Material3.TabLayout">
        <item name="tabTextColor">#B8C9E8</item>
        <item name="tabSelectedTextColor">#FFFFFF</item>
        <item name="tabIndicatorColor">#FFFFFF</item>
    </style>
    <style name="ThemeOverlay.CloneManager.Dialog" parent="ThemeOverlay.Material3.Dialog">
        <item name="colorSurface">#26497F</item>
        <item name="colorOnSurface">#FFFFFF</item>
        <item name="colorOnSurfaceVariant">#D8E4F7</item>
        <item name="colorPrimary">#7FB0FF</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#D8E4F7</item>
    </style>
    <style name="Theme.CloneManager.Light" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="colorPrimary">#1B3A6B</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="android:textColor">#000000</item>
        <item name="android:textColorHint">#6B7A99</item>
        <item name="android:colorBackground">#F0F6FF</item>
        <item name="colorSurface">#FFFFFF</item>
        <item name="colorOnSurface">#000000</item>
        <item name="colorSurfaceVariant">#E1E9F4</item>
        <item name="colorOnSurfaceVariant">#333333</item>
        <item name="colorOutline">#331B3A6B</item>
        <item name="colorError">#C62828</item>
        <item name="materialButtonStyle">@style/Widget.CloneManager.ButtonLight</item>
        <item name="checkboxStyle">@style/Widget.CloneManager.CheckboxLight</item>
        <item name="tabStyle">@style/Widget.CloneManager.TabLight</item>
        <item name="rootBackground">@drawable/bg_root_light</item>
    </style>
    <style name="Widget.CloneManager.ButtonLight" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">#1B3A6B</item>
        <item name="strokeColor">#331B3A6B</item>
        <item name="backgroundTint">@android:color/transparent</item>
    </style>
    <style name="Widget.CloneManager.CheckboxLight" parent="Widget.Material3.CompoundButton.CheckBox">
        <item name="android:button">@drawable/ic_checkbox_selector_light</item>
    </style>
    <style name="Widget.CloneManager.TabLight" parent="Widget.Material3.TabLayout">
        <item name="tabTextColor">#5A6B87</item>
        <item name="tabSelectedTextColor">#1B3A6B</item>
        <item name="tabIndicatorColor">#1B3A6B</item>
    </style>
    <style name="ThemeOverlay.CloneManager.DialogLight" parent="ThemeOverlay.Material3.Dialog">
        <item name="colorSurface">#FFFFFF</item>
        <item name="colorOnSurface">#1B2A44</item>
        <item name="colorPrimary">#1B3A6B</item>
        <item name="android:textColorPrimary">#1B2A44</item>
    </style>
    <style name="Theme.CloneManager.Dark" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="colorPrimary">#9CC3FF</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:colorBackground">#0B1424</item>
        <item name="colorSurface">#16233D</item>
        <item name="colorOnSurface">#FFFFFF</item>
        <item name="materialButtonStyle">@style/Widget.CloneManager.Button</item>
        <item name="checkboxStyle">@style/Widget.CloneManager.Checkbox</item>
        <item name="tabStyle">@style/Widget.CloneManager.Tab</item>
        <item name="rootBackground">@drawable/bg_root_dark</item>
    </style>
</resources>
