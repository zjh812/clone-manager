<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="?attr/rootBackground">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@android:color/transparent" android:paddingTop="?attr/actionBarSize"
        android:paddingBottom="12dp" android:paddingStart="8dp" android:paddingEnd="16dp"
        app:titleTextColor="?attr/colorOnSurface" app:navigationIconTint="?attr/colorOnSurface" app:title="添加应用到分身" />
    <com.google.android.material.textfield.TextInputLayout android:id="@+id/searchLayout"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:layout_marginTop="4dp"
        app:boxBackgroundMode="outline" app:startIconDrawable="@drawable/ic_search"
        app:startIconTint="?attr/colorOnSurface" android:hint="搜索应用名称或包名">
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/searchInput"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:inputType="text" android:imeOptions="actionSearch" android:maxLines="1"
            android:textColor="?attr/colorOnSurface" />
    </com.google.android.material.textfield.TextInputLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="6dp" android:paddingBottom="2dp">
        <CheckBox android:id="@+id/chkHideSystem" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="屏蔽系统应用" android:textColor="?attr/colorOnSurface"
            android:button="@drawable/ic_checkbox_selector" android:buttonTint="@null" android:checked="true" />
        <TextView android:id="@+id/countText" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="12sp" android:textColor="?attr/colorOnSurfaceVariant" android:text="0 个应用" />
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/addList"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:paddingStart="12dp" android:paddingEnd="12dp" android:clipToPadding="false" />
    <com.google.android.material.button.MaterialButton android:id="@+id/btnInstallSelected"
        style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp" android:text="安装到分身" />
</LinearLayout>
